<record id="leave_sequential_visibility_rule" model="ir.rule">
    <field name="name">Leave: Sequential Approver Visibility</field>
    <field name="model_id" ref="hr_holidays.model_hr_leave"/>
    <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_responsible'))]"/>
    <field name="domain_force" eval="[
        '|',
        ('employee_id.user_id', '=', user.id),
        '&',
            ('approval_line_ids.user_id', '=', user.id),
            ('approval_line_ids.sequence', '=', approval_step)
    ]"/>
</record>
