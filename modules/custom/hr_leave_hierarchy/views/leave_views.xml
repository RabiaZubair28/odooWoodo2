<odoo>

    <!-- Custom Time Off Management Action -->
    <record id="action_hr_leave_management_hierarchy" model="ir.actions.act_window">
        <field name="name">Time Off Approvals</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [
                "|",
                ("employee_id.parent_id.user_id", "=", uid),
                ("is_current_approver", "=", True)
            ]
        </field>
        <field name="context">{}</field>
    </record>

    <!-- Parent Menu (already working for you) -->
    <menuitem id="menu_hr_leave_hierarchy_root"
              name="Leave Workflow"
              parent="hr_holidays.menu_hr_holidays_root"/>

    <!-- Leave Hierarchies Menu (already working) -->
    <menuitem id="menu_hr_leave_hierarchy"
              name="Leave Hierarchies"
              parent="menu_hr_leave_hierarchy_root"
              action="hr_leave_hierarchy.action_hr_leave_hierarchy"/>

    <!-- NEW: Approval Inbox -->
    <menuitem id="menu_hr_leave_approval_inbox"
              name="Time Off Approvals"
              parent="menu_hr_leave_hierarchy_root"
              action="action_hr_leave_management_hierarchy"/>

    <menuitem
        id="menu_leave_workflow"
        name="Leave Workflow Details"
        parent="hr_holidays.menu_hr_holidays_root"
        action="action_hr_leave_workflow"
        sequence="60"/>

</odoo>
