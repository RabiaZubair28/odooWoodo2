<odoo>

    <record id="view_leave_form_inherit_hierarchy" model="ir.ui.view">
        <field name="name">hr.leave.form.hierarchy</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <!-- Add Approval Workflow group at the end of sheet -->
            <xpath expr="//sheet" position="inside">
                <group string="Approval Workflow">
                    <field name="hierarchy_id" readonly="1"/>
                    <field name="current_step_id" readonly="1"/>
                </group>
            </xpath>

            <!-- Add Process Step button at the end of sheet -->
            <xpath expr="//sheet" position="inside">
                <group>
                    <button name="action_process_step"
                            type="object"
                            string="Process Step"
                            class="btn-primary"
                            modifiers="{'invisible': [('current_step_id','=',False), ('state','!=','confirm')]}"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
