<odoo>
    <record id="view_hr_leave_workflow_form" model="ir.ui.view">
        <field name="name">hr.leave.workflow.form</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <form string="Leave Workflow">
                <sheet>

                    <!-- BASIC INFO -->
                    <group>
                        <field name="employee_id"/>
                        <field name="holiday_status_id"/>
                        <field name="hierarchy_id"/>
                        <field name="current_step_id"/>
                        <field name="state"/>
                    </group>

                    <notebook>

                        <!-- CURRENT APPROVERS -->
                        <page string="Current Approvers">
                            <field name="approver_ids" widget="many2many_tags" readonly="1"/>
                        </page>

                        <!-- APPROVAL HISTORY -->
                        <page string="Approval History">
                            <field name="approval_log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="step_id"/>
                                    <field name="user_id"/>
                                    <field name="action_type"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>
</odoo>
