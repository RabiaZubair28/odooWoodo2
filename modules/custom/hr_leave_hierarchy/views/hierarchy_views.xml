<odoo>
    <record id="view_leave_hierarchy_form" model="ir.ui.view">
        <field name="name">hr.leave.hierarchy.form</field>
        <field name="model">hr.leave.hierarchy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                    <field name="step_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="approver_ids"/>
                            <field name="mode"/>
                            <field name="action_type"/>
                            <field name="notify_next"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
