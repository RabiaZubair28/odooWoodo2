<odoo>
    <record id="view_hr_leave_workflow_list" model="ir.ui.view">
        <field name="name">hr.leave.workflow.list</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <list string="Leave Workflow">
                <field name="employee_id"/>
                <field name="holiday_status_id"/>
                <field name="hierarchy_id"/>
                <field name="current_step_id"/>
                <field name="state"/>
                <field name="request_date_from"/>
                <field name="request_date_to"/>
            </list>
        </field>
    </record>
</odoo>
